# Version control and local tooling
**/.git
**/.git*
**/.agents
**/.codex
**/.idea
**/.vscode
.hadolint.yaml

# Secrets and local credentials (including .env.example)
**/.env
**/.env.*
**/.envrc
**/.aws
**/.ssh
**/.kube
**/.docker
**/.config
**/.netrc
**/.pypirc
**/.pgpass
**/secrets
**/*credentials*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Python caches, environments and build artifacts
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage*
**/htmlcov
**/.tox
**/.nox
**/.venv
**/venv
**/env
**/build
**/dist
**/*.egg-info
**/*.egg
**/*.whl

# Tests, reports and infrastructure are not application runtime files
**/test_*.py
**/*_test.py
**/tests
**/*.md
security-evidence
aws
**/.terraform
**/*.tf
**/*.tfvars
**/*.tfvars.json
**/*.tfstate*
docker-compose*.yml
docker-compose*.yaml
.flake8

# Logs, archives and temporary files
**/*.log
**/*.zip
**/*.tar
**/*.tar.*
**/*.tgz
**/*.gz
**/*.bz2
**/*.xz
**/*.7z
**/*.rar
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~
**/.DS_Store

# Keep app.py, requirements.txt and requirements-runtime.txt in the context.
